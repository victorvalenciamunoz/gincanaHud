@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject AdminApiClient Api
@inject AdminSession Session
@inject NavigationManager Nav

<PageTitle>Login — Admin</PageTitle>

<p class="login-kicker">GincanaHud</p>
<h1>Entrar</h1>
<p class="page-lead">
    SuperAdmin o admin de empresa.
</p>

@if (_failed)
{
    <p class="error">Usuario o contraseña incorrectos (o la API no está lista).</p>
}

<form class="form-stack" @onsubmit="LoginAsync">
    <div class="field">
        <label for="username">Usuario</label>
        <input id="username" @bind="_username" autocomplete="username" required autofocus />
    </div>
    <div class="field">
        <label for="password">Contraseña</label>
        <input id="password" @bind="_password" type="password" autocomplete="current-password" required />
    </div>
    <button type="submit" disabled="@_busy">Entrar</button>
</form>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    string _username = "";
    string _password = "";
    bool _failed;
    bool _busy;

    async Task LoginAsync()
    {
        _busy = true;
        _failed = false;
        try
        {
            var session = await Api.LoginAsync(_username.Trim(), _password);
            if (session is null || session.Role is not (AdminRoles.SuperAdmin or AdminRoles.OrganizationAdmin))
            {
                _failed = true;
                return;
            }

            await Session.SignInAsync(session);
            // Only paths inside the panel: "//host" would leave the site.
            var target = ReturnUrl is { Length: > 0 } url && url.StartsWith('/') && !url.StartsWith("//") ? url : "/";
            Nav.NavigateTo(target);
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
