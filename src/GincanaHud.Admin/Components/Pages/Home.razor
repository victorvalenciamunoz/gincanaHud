@page "/"
@rendermode InteractiveServer
@inject AdminApiClient Api
@inject IHttpContextAccessor Http

<PageTitle>Admin</PageTitle>

<p class="page-kicker">Panel</p>
<h1>Hoy</h1>
<p class="page-lead">Eventos, puntos y jugadores de tu organización.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <p class="error">@_error</p>
}
else if (_loading)
{
    <p class="page-lead">Cargando…</p>
}
else
{
    <div class="stats">
        <a class="stat-card" href="/users">
            <strong>@_players</strong>
            <span>jugadores</span>
        </a>
        <a class="stat-card" href="/activities">
            <strong>@_activities</strong>
            <span>actividades</span>
        </a>
        <a class="stat-card" href="/pois">
            <strong>@_pois</strong>
            <span>POIs</span>
        </a>
        <a class="stat-card stat-card-live" href="/live">
            <strong>En vivo</strong>
            <span>ranking y progreso</span>
        </a>
    </div>
}

@code {
    int _players;
    int _activities;
    int _pois;
    bool _loading = true;
    string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = Http.HttpContext?.User;
            var isSuper = AdminPrincipal.IsSuperAdmin(user);
            Guid? orgId = null;
            if (!isSuper)
            {
                var orgClaim = user?.FindFirst(AdminClaimTypes.OrganizationId)?.Value;
                if (Guid.TryParse(orgClaim, out var oid))
                    orgId = oid;
            }

            var usersTask = Api.GetUsersAsync(orgId);
            var activitiesTask = Api.GetActivitiesAsync(includeInactive: true);
            var poisTask = Api.GetPoisAsync(orgId);
            await Task.WhenAll(usersTask, activitiesTask, poisTask);

            _players = (await usersTask)?.Count ?? 0;
            var activities = await activitiesTask ?? [];
            if (orgId is Guid filter)
                activities = activities.Where(a => a.OrganizationId == filter).ToList();
            _activities = activities.Count;
            _pois = (await poisTask)?.Count ?? 0;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
