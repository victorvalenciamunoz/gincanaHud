@page "/live"
@page "/live/{ActivityId:guid}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject AdminApiClient Api
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>En vivo</PageTitle>

<div class="live-page">
    <div class="live-title-row">
        <div>
            <p class="live-kicker">GincanaHud · control de evento</p>
            <h1>En vivo</h1>
            <p class="page-lead">Progreso y orden de meta. Se actualiza solo cada 3 s.</p>
        </div>
        <div class="live-pulse @(_autoRefresh && _live is not null ? "is-on" : "")" title="Auto-refresh">
            <span class="live-pulse-dot"></span>
            LIVE
        </div>
    </div>

    <div class="form-row live-controls">
        <select @bind="_selectedId" @bind:after="OnActivityChangedAsync" disabled="@_loadingList">
            <option value="">— Elige actividad —</option>
            @foreach (var a in _activities)
            {
                <option value="@a.Id">@a.Title (@a.JoinCode)</option>
            }
        </select>
        <label class="check">
            <input type="checkbox" @bind="_autoRefresh" /> Auto-refresh
        </label>
        <button type="button" class="btn-muted" @onclick="() => RefreshAsync(false)" disabled="@(_selectedGuid is null || _busy)">
            Actualizar
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="error">@_error</p>
    }

    @if (_live is not null)
    {
        <div class="live-banner">
            <div class="live-banner-main">
                <h2>@_live.Title</h2>
                <div class="live-code-block">
                    <span class="live-code-label">CÓDIGO</span>
                    <span class="live-code">@_live.JoinCode</span>
                </div>
                <p class="live-banner-meta">
                    @(_live.RouteMode == ActivityRouteMode.Free ? "Ruta libre" : "Ruta secuencial")
                    · @_live.ParticipantCount inscritos
                    · @_live.PoiCount puntos en ruta
                    · ventana @_live.StartsAt.ToLocalTime().ToString("HH:mm")–@_live.EndsAt.ToLocalTime().ToString("HH:mm")
                </p>
            </div>
            <div class="live-stamp mono">
                <div>sync</div>
                <div class="live-stamp-time">@_live.GeneratedAt.ToLocalTime().ToString("HH:mm:ss")</div>
            </div>
        </div>

        <div class="stats live-stats">
            <div class="stat-meta"><strong>@_live.FinisherCount</strong><span>en meta</span></div>
            <div class="stat-secondary"><strong>@OnRouteCount</strong><span>en ruta</span></div>
            <div class="stat-secondary"><strong>@AtStartCount</strong><span>en salida</span></div>
            <div class="stat-inscritos"><strong>@_live.ParticipantCount</strong><span>inscritos</span></div>
        </div>

        @if (_podium.Count > 0)
        {
            <div class="live-podium">
                @foreach (var slot in _podium)
                {
                    <div class="live-podium-card place-@slot.Place @(slot.JustFinished ? "just-finished" : "")">
                        <div class="live-podium-place">#@slot.Place</div>
                        <div class="live-podium-name">@slot.Name</div>
                        <div class="live-podium-time mono">@slot.Time</div>
                        @if (!string.IsNullOrEmpty(slot.Contact))
                        {
                            <div class="live-podium-contact mono">@slot.Contact</div>
                        }
                    </div>
                }
            </div>
        }

        @if (_live.Players.Count == 0)
        {
            <p class="page-lead">Nadie se ha unido todavía. Comparte el código o el QR.</p>
        }
        else
        {
            <table class="live-table live-table-desktop">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Jugador</th>
                        <th>Estado</th>
                        <th>Progreso</th>
                        <th>Siguiente / Meta</th>
                        <th>Contacto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _live.Players)
                    {
                        var justFinished = _justFinished.Contains(p.UserId);
                        var rowClass = PlayerRowClass(p, justFinished);
                        var pct = ProgressPct(p);
                        <tr class="@rowClass">
                            <td class="mono">@(p.FinishPlace?.ToString() ?? "—")</td>
                            <td>
                                <strong>@p.DisplayName</strong>
                                @if (justFinished)
                                {
                                    <span class="live-badge">META</span>
                                }
                            </td>
                            <td>@p.Status</td>
                            <td>
                                <div class="live-progress">
                                    <div class="live-progress-bar" style="width:@pct%"></div>
                                </div>
                                <span class="mono live-progress-label">@p.CapturedCount / @p.PoiTotal</span>
                            </td>
                            <td>
                                @if (p.FinishedAt is { } fin)
                                {
                                    <span class="live-meta">@fin.ToLocalTime().ToString("HH:mm:ss")</span>
                                }
                                else if (p.CurrentOrder is int order)
                                {
                                    <span>#@order · @(p.CurrentPoiName ?? "POI")</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="mono">@(p.ContactEmail ?? p.ContactPhone ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="live-cards">
                @foreach (var p in _live.Players)
                {
                    var justFinished = _justFinished.Contains(p.UserId);
                    var rowClass = PlayerRowClass(p, justFinished);
                    var pct = ProgressPct(p);
                    <article class="live-card @rowClass">
                        <div class="live-card-top">
                            <div class="live-card-place mono">@(p.FinishPlace?.ToString() ?? "—")</div>
                            <div class="live-card-name">
                                <strong>@p.DisplayName</strong>
                                @if (justFinished)
                                {
                                    <span class="live-badge">META</span>
                                }
                            </div>
                            <div class="live-card-status">@p.Status</div>
                        </div>
                        <div class="live-progress">
                            <div class="live-progress-bar" style="width:@pct%"></div>
                        </div>
                        <div class="live-card-meta">
                            <span class="mono">@p.CapturedCount / @p.PoiTotal</span>
                            @if (p.FinishedAt is { } fin)
                            {
                                <span class="live-meta">@fin.ToLocalTime().ToString("HH:mm:ss")</span>
                            }
                            else if (p.CurrentOrder is int order)
                            {
                                <span>#@order · @(p.CurrentPoiName ?? "POI")</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(p.ContactEmail) || !string.IsNullOrWhiteSpace(p.ContactPhone))
                        {
                            <div class="live-card-contact mono">@(p.ContactEmail ?? p.ContactPhone)</div>
                        }
                    </article>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid? ActivityId { get; set; }

    sealed record PodiumView(int Place, string Name, string Time, string? Contact, bool JustFinished);

    List<ActivitySummaryDto> _activities = [];
    LiveProgressDto? _live;
    List<PodiumView> _podium = [];
    string _selectedId = "";
    Guid? _selectedGuid;
    bool _autoRefresh = true;
    bool _busy;
    bool _loadingList = true;
    string? _error;
    CancellationTokenSource? _loopCts;

    readonly HashSet<Guid> _knownFinishers = [];
    readonly Dictionary<Guid, DateTimeOffset> _justFinishedUntil = [];
    HashSet<Guid> _justFinished = [];
    bool _finishersSeeded;

    int OnRouteCount => _live?.Players.Count(p => p.FinishedAt is null && p.CapturedCount > 0) ?? 0;
    int AtStartCount => _live?.Players.Count(p => p.FinishedAt is null && p.CapturedCount == 0) ?? 0;

    static string PlayerRowClass(LivePlayerProgressDto p, bool justFinished) =>
        p.FinishedAt is not null
            ? $"live-finisher{(justFinished ? " just-finished" : "")}"
            : p.CapturedCount == 0 ? "live-start" : "live-route";

    static int ProgressPct(LivePlayerProgressDto p) =>
        p.PoiTotal <= 0 ? 0 : (int)Math.Round(100.0 * p.CapturedCount / p.PoiTotal);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Guid? orgId = null;
            var user = Http.HttpContext?.User;
            if (!AdminPrincipal.IsSuperAdmin(user))
            {
                var orgClaim = user?.FindFirst(AdminClaimTypes.OrganizationId)?.Value;
                if (Guid.TryParse(orgClaim, out var oid))
                    orgId = oid;
            }

            var all = await Api.GetActivitiesAsync(includeInactive: true) ?? [];
            if (orgId is Guid filterOrg)
                all = all.Where(a => a.OrganizationId == filterOrg).ToList();

            _activities = all.OrderByDescending(a => a.StartsAt).ToList();

            if (ActivityId is Guid fromRoute)
            {
                _selectedGuid = fromRoute;
                _selectedId = fromRoute.ToString();
            }
            else if (_activities.Count == 1)
            {
                _selectedGuid = _activities[0].Id;
                _selectedId = _activities[0].Id.ToString();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loadingList = false;
        }

        if (_selectedGuid is not null)
            await RefreshAsync(false);

        RestartLoop();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ActivityId is Guid id && id != _selectedGuid)
        {
            _selectedGuid = id;
            _selectedId = id.ToString();
            ResetFinisherTracking();
            await RefreshAsync(false);
        }
    }

    async Task OnActivityChangedAsync()
    {
        if (Guid.TryParse(_selectedId, out var id))
        {
            _selectedGuid = id;
            ResetFinisherTracking();
            if (!Nav.Uri.Contains(id.ToString(), StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo($"/live/{id}", replace: true);
            await RefreshAsync(false);
        }
        else
        {
            _selectedGuid = null;
            _live = null;
            _podium = [];
        }
    }

    async Task RefreshAsync(bool silent)
    {
        if (_selectedGuid is null)
            return;

        if (!silent)
            _busy = true;
        _error = null;
        try
        {
            var next = await Api.GetLiveProgressAsync(_selectedGuid.Value);
            if (next is null)
            {
                _error = "No se pudo cargar el progreso.";
                return;
            }

            ApplyLiveSnapshot(next);
            _live = next;
            RebuildPodium();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            if (!silent)
                _busy = false;
        }
    }

    void ResetFinisherTracking()
    {
        _knownFinishers.Clear();
        _justFinishedUntil.Clear();
        _justFinished = [];
        _finishersSeeded = false;
    }

    void ApplyLiveSnapshot(LiveProgressDto next)
    {
        var now = DateTimeOffset.UtcNow;
        var finishers = next.Players.Where(x => x.FinishedAt is not null).ToList();

        if (!_finishersSeeded)
        {
            foreach (var p in finishers)
                _knownFinishers.Add(p.UserId);
            _finishersSeeded = true;
            _justFinished = [];
            return;
        }

        foreach (var p in finishers)
        {
            if (_knownFinishers.Add(p.UserId))
                _justFinishedUntil[p.UserId] = now.AddSeconds(12);
        }

        foreach (var id in _justFinishedUntil.Where(kv => kv.Value < now).Select(kv => kv.Key).ToList())
            _justFinishedUntil.Remove(id);

        _justFinished = _justFinishedUntil.Keys.ToHashSet();
    }

    void RebuildPodium()
    {
        if (_live is null)
        {
            _podium = [];
            return;
        }

        _podium = _live.Players
            .Where(p => p.FinishedAt is not null && p.FinishPlace is not null)
            .OrderBy(p => p.FinishPlace)
            .Take(3)
            .Select(p => new PodiumView(
                p.FinishPlace!.Value,
                p.DisplayName,
                p.FinishedAt!.Value.ToLocalTime().ToString("HH:mm:ss"),
                p.ContactEmail ?? p.ContactPhone,
                _justFinished.Contains(p.UserId)))
            .ToList();

        // Orden visual 2 · 1 · 3
        if (_podium.Count >= 2)
        {
            var ordered = new List<PodiumView>();
            var second = _podium.FirstOrDefault(x => x.Place == 2);
            var first = _podium.FirstOrDefault(x => x.Place == 1);
            var third = _podium.FirstOrDefault(x => x.Place == 3);
            if (second is not null) ordered.Add(second);
            if (first is not null) ordered.Add(first);
            if (third is not null) ordered.Add(third);
            // Si falta alguno del medio, conservar orden natural.
            _podium = ordered.Count > 0 ? ordered : _podium;
        }
    }

    void RestartLoop()
    {
        _loopCts?.Cancel();
        _loopCts?.Dispose();
        _loopCts = new CancellationTokenSource();
        _ = RunLoopAsync(_loopCts.Token);
    }

    async Task RunLoopAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (!_autoRefresh || _selectedGuid is null)
                    continue;
                await RefreshAsync(silent: true);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            /* disposed */
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_loopCts is not null)
        {
            await _loopCts.CancelAsync();
            _loopCts.Dispose();
            _loopCts = null;
        }
    }
}
