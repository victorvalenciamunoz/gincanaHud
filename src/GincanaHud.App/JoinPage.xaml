<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GincanaHud.App.ViewModels"
             x:Class="GincanaHud.App.JoinPage"
             x:DataType="vm:JoinViewModel"
             Title="Unirse"
             BackgroundColor="#071018">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
                <GradientStop Color="#06141A" Offset="0" />
                <GradientStop Color="#0A2A22" Offset="0.45" />
                <GradientStop Color="#0B1218" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Atmosphere: soft radial-ish wash via layered boxes -->
        <BoxView Color="#1F6F4A"
                 Opacity="0.12"
                 WidthRequest="320"
                 HeightRequest="320"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 Margin="0,-80,-100,0"
                 InputTransparent="True" />
        <BoxView Color="#0E3D55"
                 Opacity="0.18"
                 WidthRequest="280"
                 HeightRequest="280"
                 HorizontalOptions="Start"
                 VerticalOptions="End"
                 Margin="-90,0,0,-60"
                 InputTransparent="True" />

        <ScrollView>
            <VerticalStackLayout Padding="24,36,24,28" Spacing="0">

                <!-- Hero: brand first -->
                <Label Text="GincanaHud"
                       FontFamily="ChakraPetchBold"
                       TextColor="#7CFFB2"
                       FontSize="40"
                       CharacterSpacing="1.2"
                       Margin="0,8,0,0" />
                <Label Text="La pista está ahí fuera."
                       FontFamily="ChakraPetch"
                       TextColor="#E8EEF4"
                       FontSize="20"
                       Margin="0,6,0,0" />
                <Label Text="Código del cartel, tu nombre, y a buscar."
                       TextColor="#8FA0B0"
                       FontSize="14"
                       Margin="0,8,0,0" />

                <Label Text="{Binding Status}"
                       TextColor="#C5D0DB"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       Margin="0,18,0,0" />

                <!-- Join form -->
                <Label Text="Código"
                       TextColor="#7CFFB2"
                       FontFamily="ChakraPetch"
                       FontSize="12"
                       CharacterSpacing="1.5"
                       Margin="0,28,0,6" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0"
                           Text="{Binding JoinCode}"
                           Placeholder="DEMO01"
                           PlaceholderColor="#5A6A7A"
                           TextColor="White"
                           BackgroundColor="#141C24"
                           Keyboard="Text"
                           MaxLength="12"
                           HeightRequest="48"
                           FontSize="18" />
                    <Button Grid.Column="1"
                            Text="QR"
                            Clicked="OnScanClicked"
                            BackgroundColor="#1A2834"
                            TextColor="#E8EEF4"
                            WidthRequest="72"
                            HeightRequest="48"
                            CornerRadius="8" />
                </Grid>

                <Label Text="Tu nombre"
                       TextColor="#7CFFB2"
                       FontFamily="ChakraPetch"
                       FontSize="12"
                       CharacterSpacing="1.5"
                       Margin="0,16,0,6" />
                <Entry Text="{Binding DisplayName}"
                       Placeholder="Cómo te llaman en el ranking"
                       PlaceholderColor="#5A6A7A"
                       TextColor="White"
                       BackgroundColor="#141C24"
                       HeightRequest="48" />

                <Label Text="Contacto (premios, opcional)"
                       TextColor="#6B7C8D"
                       FontSize="12"
                       Margin="0,16,0,6" />
                <Entry Text="{Binding ContactEmail}"
                       Placeholder="Email"
                       PlaceholderColor="#5A6A7A"
                       TextColor="White"
                       BackgroundColor="#141C24"
                       Keyboard="Email"
                       HeightRequest="44"
                       Margin="0,0,0,8" />
                <Entry Text="{Binding ContactPhone}"
                       Placeholder="Teléfono"
                       PlaceholderColor="#5A6A7A"
                       TextColor="White"
                       BackgroundColor="#141C24"
                       Keyboard="Telephone"
                       HeightRequest="44" />

                <Button Text="Unirme y empezar"
                        Command="{Binding JoinCommand}"
                        BackgroundColor="#1F6F4A"
                        TextColor="White"
                        FontFamily="ChakraPetchBold"
                        FontSize="17"
                        HeightRequest="52"
                        CornerRadius="10"
                        Margin="0,24,0,0" />

                <BoxView HeightRequest="1" Color="#1E2A36" Margin="0,28" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="Sonido y vibración"
                               TextColor="#E8EEF4"
                               FontSize="15" />
                        <Label Text="Campanas al capturar un punto"
                               TextColor="#6B7C8D"
                               FontSize="12" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1"
                            IsToggled="{Binding SoundEnabled, Mode=TwoWay}"
                            OnColor="#1F6F4A"
                            ThumbColor="#7CFFB2"
                            VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout IsVisible="{Binding HasSession}"
                                     Spacing="8"
                                     Margin="0,28,0,0">
                    <Label Text="Sesión"
                           TextColor="#6B7C8D"
                           FontFamily="ChakraPetch"
                           FontSize="12"
                           CharacterSpacing="1.5" />
                    <Label Text="{Binding SessionSummary}"
                           TextColor="#C5D0DB"
                           FontSize="14" />
                    <Button Text="Salir de la actividad"
                            Command="{Binding ClearSessionCommand}"
                            BackgroundColor="#1A2834"
                            TextColor="#C5D0DB"
                            HeightRequest="44"
                            CornerRadius="8" />
                </VerticalStackLayout>

                <Button x:Name="SensorsDebugButton"
                        Text="Sensores (debug)"
                        IsVisible="False"
                        Clicked="OnSensorsDebugClicked"
                        BackgroundColor="Transparent"
                        TextColor="#4A5A6A"
                        Margin="0,24,0,0"
                        FontSize="12" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
