<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android-first for street tests; add ios/windows later -->
		<TargetFrameworks>net11.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>GincanaHud.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Required for XAML C# Expressions (experimental in MAUI 11) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>

		<ApplicationTitle>GincanaHud</ApplicationTitle>
		<ApplicationId>com.gincanahud.app</ApplicationId>
		<ApplicationDisplayVersion>1.0.1</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Fast Deployment deja R.id desfasados en el teléfono (.NET 10/11).
	     Síntoma: crash al arrancar "No view found for id …/jumpToEnd" (u otro nombre aleatorio). -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1218" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B1218" BaseSize="256,256" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0-preview.6.26360.8" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-preview.6.26359.118" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.0" />
		<PackageReference Include="CommunityToolkit.Maui.Camera" Version="6.1.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\GincanaHud.Shared\GincanaHud.Shared.csproj" />
	</ItemGroup>

</Project>
